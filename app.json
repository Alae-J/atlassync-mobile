{
  "expo": {
    "name": "AtlasSync",
    "slug": "atlassync-mobile",
    "scheme": "atlassync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F2933"
    },
    "ios": {
      "bundleIdentifier": "com.atlassync.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.atlassync.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AtlasSync to use your camera to scan product barcodes while you shop."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AtlasSync to access your photo library so you can pick a profile picture.",
          "cameraPermission": "Allow AtlasSync to use your camera to take a profile picture."
        }
      ]
    ]
  }
}
